# Required: Google Gemini API key (when LLM_PROVIDER=gemini)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek (OpenAI-compatible API) for montage testing
# https://platform.deepseek.com/
# DEEPSEEK_API_KEY=
# LLM_PROVIDER=auto              # auto | gemini | deepseek
#   auto     — Gemini, fallback to DeepSeek on failure (if key is set)
#   gemini   — Gemini only
#   deepseek — DeepSeek only (text, no video)
# DEEPSEEK_MODEL=deepseek-chat   # or deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional
# GEMINI_MODEL=gemini-3.1-flash-lite
# DEBUG=false
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=          # optional ISO 639-1 code (e.g. en, de); auto-detect if unset
#
# NVIDIA GPU (requires nvidia-container-toolkit on the host):
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build
# Override sets WHISPER_DEVICE=cuda and WHISPER_COMPUTE_TYPE=float16.

# Phase 12: standalone STT service
# STT_CACHE_ENABLED=true
# USE_VIDEO_FOR_LLM=false by default — montage uses text-out Gemini models (transcript + timeline).
# USE_VIDEO_FOR_LLM=true
# SKIP_STT_IF_TRANSCRIPT_PROVIDED=true

# Phase 13: STT engine (whisper | silero | gigaam | auto)
#   whisper — general-purpose (default)
#   gigaam  — offline GigaAM STT (sherpa-onnx + GigaAM)
#   silero  — en/de/es/ua only
#   auto    — language code ru → gigaam (if available), en/de/es/ua → silero, else whisper
# STT_ENGINE=whisper

# --- Silero (en/de/es/ua) ---
# For Silero in Docker: INSTALL_SILERO=1 at build time
# SILERO_LANGUAGE=en
# INSTALL_SILERO=0

# --- GigaAM (offline STT) ---
# For GigaAM in Docker: INSTALL_GIGAAM=1 at build (downloads models ~230MB)
# Locally: pip install -r requirements-gigaam.txt && python scripts/download_gigaam.py
# INSTALL_GIGAAM=0
# GIGAAM_MODEL_DIR=storage/models/gigaam-ru
# GIGAAM_VAD_MODEL=storage/models/silero_vad.onnx

# Phase 14: Adobe Premiere Pro plugin (CEP panel + local path API)
# PLUGIN_ENABLED=true
# PLUGIN_ALLOW_ANY_LOCAL_PATH=true
# PLUGIN_ALLOWED_ROOTS=/Users/me/Videos,/home/me/Videos
# PLUGIN_COPY_MEDIA_TO_STORAGE=false
# PLUGIN_CORS_ALLOW_ALL=true

# Phase 15: turnkey clip (stitched MP4 render)
# RENDER_CRF=20
# RENDER_PRESET=medium
# RENDER_AUDIO_BITRATE=160k

# Phase 16/17: burned-in subtitles
# SUBTITLE_FONT_SIZE=16
# SUBTITLE_FONT_NAME=DejaVu Sans   # DejaVu Sans | PT Sans | Roboto | Noto Sans
# SUBTITLE_OUTLINE=2
# SUBTITLE_MARGIN_V=40
# SUBTITLE_CRF=20
# SUBTITLE_PRESET=medium
# Karaoke-style chunking (1..N words synced to speech, fit to frame width)
# SUBTITLE_AUTO_CHUNK=true
# SUBTITLE_MAX_WORDS=3
# SUBTITLE_CHAR_RATIO=0.6
# SUBTITLE_SIDE_MARGIN=40
# Orthography/punctuation proofreading: silero (local, torch) | gemini | auto | none
# PROOFREAD_ENGINE=silero
# PROOFREAD_LANGUAGE=en

# Scene detection proxy: low resolution + low FPS for fast FFmpeg analysis
# SCENE_PROXY_HEIGHT=240
# SCENE_PROXY_FPS=12
# SCENE_PROXY_CRF=34
# SCENE_PROXY_PRESET=ultrafast
# SCENE_THRESHOLD=0.3
# MIN_SCENE_DURATION_SEC=0.8
