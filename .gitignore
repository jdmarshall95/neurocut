# Secrets & local env
.env
.env.*
!.env.example

# Runtime / media artifacts (job storage)
storage/*
!storage/.gitkeep
!storage/models/.gitkeep
storage/models/**
!storage/models/.gitkeep

# Local test media / capture inputs (not part of the public repo)
storage/test-input/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
transcription_progress.json

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Spurious root lockfile (real lockfile lives in frontend/)
/package-lock.json

# Demo capture intermediates (script-generated; keep final gif/mp4/png in docs/assets)
scripts/capture-ui-demo.frames.txt
scripts/*.frames.txt
/tmp/shot/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local model / tool caches
.cache/
.playwright/
playwright-report/
test-results/

# Logs
*.log
logs/

# Local identity pins (do not publish)
.mailmap
.cursor/rules/git-author.mdc
